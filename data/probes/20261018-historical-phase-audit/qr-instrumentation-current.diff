@@ -3,0 +4,29 @@ use linalg::householder::{self};
+
+// DIAGNOSTIC ONLY (not for commit): phase attribution for qr_in_place.
+#[doc(hidden)]
+pub mod qr_probe {
+	use core::sync::atomic::{AtomicU64, Ordering};
+	pub static APPLY_CALLS: AtomicU64 = AtomicU64::new(0);
+	pub static APPLY_NS: AtomicU64 = AtomicU64::new(0);
+	pub static UPGRADE_CALLS: AtomicU64 = AtomicU64::new(0);
+	pub static UPGRADE_NS: AtomicU64 = AtomicU64::new(0);
+	pub static PANEL_NS: AtomicU64 = AtomicU64::new(0);
+	/// bit 0: force the trailing block apply sequential; bit 1: force the
+	/// compact-WY upgrade sequential.
+	pub fn seq_mask() -> u64 {
+		use std::sync::OnceLock;
+		static MASK: OnceLock<u64> = OnceLock::new();
+		*MASK.get_or_init(|| {
+			std::env::var("QR_PROBE_SEQ").ok().and_then(|s| s.parse().ok()).unwrap_or(0)
+		})
+	}
+	pub fn take() -> (u64, u64, u64, u64, u64) {
+		(
+			APPLY_CALLS.swap(0, Ordering::Relaxed),
+			APPLY_NS.swap(0, Ordering::Relaxed),
+			UPGRADE_CALLS.swap(0, Ordering::Relaxed),
+			UPGRADE_NS.swap(0, Ordering::Relaxed),
+			PANEL_NS.swap(0, Ordering::Relaxed),
+		)
+	}
+}
