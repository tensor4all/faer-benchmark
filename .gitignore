# Checkouts of the two measured libraries. Nothing here is committed: they are
# linked by path by scripts/build_for_faer_rev.sh, and the revisions that were
# measured are recorded per run in run.yaml. The *reference* revisions are
# pins/t4a-faer.rev and pins/upstream-faer.rev.
extern/t4a-faer
extern/upstream-faer
__pycache__/
.venv/
.wt/

# Untracked probe build trees from the early experiments. Their results live in
# data/probes/ and the measured library's docs/worklogs, not here; without this
# they show up as 676 MB of untracked build output.
probes/

# the landing page is generated by the Pages workflow on every deploy; never committed
/result/index.html
/result/history.html
